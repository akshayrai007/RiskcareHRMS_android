<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- Center content -->
    <LinearLayout
        android:id="@+id/logoLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Logo image: Logo.png (Risk|Care box, same as login & web) -->
        <com.riskcare.app.ui.widget.WheelRevealImageView
            android:id="@+id/ivLogo"
            android:layout_width="150dp"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:src="@drawable/ic_logo_brand"
            android:scaleType="fitCenter"/>

        <!-- Logo name: Risk[Care]HR — "Care" styled cyan in Activity -->
        <TextView
            android:id="@+id/tvLogoName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="RiskCare-HRMS"
            android:textColor="#1A2B5A"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.01"/>

        <!-- Tagline: Servicing All Risks -->
        <TextView
            android:id="@+id/tvTagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_tagline"
            android:textColor="#7A9E80"
            android:textSize="13sp"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:alpha="0"/>
    </LinearLayout>

    <!-- Spinning wheel icon — white tint removed, use red on white bg -->
    <ImageView
        android:id="@+id/ivWheel"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:src="@drawable/ic_wheel"
        android:alpha="0"
        app:tint="#E8303A"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="110dp"/>

    <!-- Status message -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#888888"
        android:textSize="13sp"
        android:gravity="center"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="88dp"/>

    <!-- Version -->
    <TextView
        android:id="@+id/tvVersion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="v1.0.0"
        android:textColor="#AAAAAA"
        android:textSize="12sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="20dp"/>

</androidx.constraintlayout.widget.ConstraintLayout>
